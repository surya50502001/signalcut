# ==============================================================================
# SignalCut SaaS Platform - Environment Variables Configuration
# Copy this file to .env and supply your production values.
# NEVER commit real credentials or production secret keys to version control.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
DATABASE_URL=Host=localhost;Port=5432;Database=signalcut_db;Username=postgres;Password=your_secure_db_password
POSTGRES_USER=signalcut
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=signalcut_db

# --- CACHE & QUEUE ---
REDIS_URL=localhost:6379

# --- SECURITY & AUTHENTICATION ---
# Minimum 32 characters long symmetric secret for signing JWTs
JWT_SECRET=your_production_secret_key_minimum_32_characters_long_123456
JWT_ISSUER=signalcut.app
JWT_AUDIENCE=signalcut.app
# 32-character key for AES-256 encryption of social OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=SignalCutEncryptionSecret32Bytes!!

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- AI WORKER & MODEL CONFIGURATION ---
# Primary AI Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=your_gemini_api_key_here
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.2
AI_WORKER_URL=http://localhost:8000

# --- DISCOVERY & SEARCH CONFIGURATION ---
# Optional: YouTube Data API v3 key (SignalCut automatically falls back to yt-dlp search if not supplied)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# --- SPEECH TO TEXT & TRANSCRIPTION ---
# Options: Gemini, YouTube-Captions, Whisper
TRANSCRIPTION_PROVIDER=Gemini

TRANSCRIPTION_API_KEY=your_transcription_provider_key

# --- OBJECT STORAGE (S3 / Cloudflare R2 / Azure Blob) ---
STORAGE_PROVIDER=LocalStorage
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET_NAME=signalcut-production-media
STORAGE_PUBLIC_CDN_URL=https://cdn.signalcut.app

# --- PAYMENTS (Stripe & Razorpay) ---
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- SOCIAL PUBLISHING PLATFORM API KEYS ---
# YouTube Data API v3
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Instagram Graph API
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# LinkedIn Share on LinkedIn API
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# --- COST CONTROL HARD LIMITS ---
MAX_SEARCH_RESULTS=50
MAX_TRANSCRIPT_LENGTH=100000
MAX_VIDEO_DURATION_SECONDS=180
MAX_CONCURRENT_JOBS_PER_ORG=5
MAX_STORAGE_GB_PER_ORG=25
